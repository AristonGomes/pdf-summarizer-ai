# ============================================================================
# PDF SUMMARIZER AI - Configuração de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha os valores reais
# 
# IMPORTANTE: Nunca commit do arquivo .env na versão de controle!
# Adicione .env ao .gitignore
# ============================================================================

# ============================================================================
# CONFIGURAÇÃO OBRIGATÓRIA
# ============================================================================

# Chave da API Google Gemini
# Obtém em: https://aistudio.google.com/app/apikey
# Formato: AIzaSy... (chave de produção)
# Necessária para gerar resumos com Google Gemini AI
GOOGLE_API_KEY=sua_chave_api_aqui

# ============================================================================
# CONFIGURAÇÃO DO SERVIDOR (OPCIONAL)
# ============================================================================

# Host onde a API será executada
# 0.0.0.0 = aceita conexões de qualquer interface (recomendado para produção)
# 127.0.0.1 = apenas localhost (padrão em desenvolvimento)
# HOST=0.0.0.0

# Porta onde a API será executada
# Padrão: 8000
# PORT=8000

# Modo debug (ativa logs detalhados e reload automático)
# true = ativado (desenvolvimento)
# false = desativado (produção)
# DEBUG=false

# ============================================================================
# CONFIGURAÇÃO DE PROCESSAMENTO (OPCIONAL)
# ============================================================================

# Tamanho máximo de arquivo PDF em MB
# Padrão: 10 MB
# MAX_FILE_SIZE_MB=10

# Timeout para processar um PDF em segundos
# Padrão: 300 segundos (5 minutos)
# TIMEOUT_SECONDS=300

# Tamanho padrão do resumo
# Opções: short (150 palavras), medium (300 palavras), long (500 palavras)
# Padrão: medium
# TAMANHO_RESUMO_PADRAO=medium

# Idioma padrão para resumos
# Opções: pt (português), en (inglês), es (espanhol), fr (francês)
# Padrão: pt
# IDIOMA_PADRAO=pt

# ============================================================================
# CONFIGURAÇÃO DE LOGGING (OPCIONAL)
# ============================================================================

# Nível de log
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Padrão: INFO
# LOG_LEVEL=INFO

# Arquivo de log (se vazio, apenas stdout)
# LOG_FILE=pdf-summarizer.log

# ============================================================================
# CONFIGURAÇÃO DE CORS (OPCIONAL - Desenvolvimento)
# ============================================================================

# URLs permitidas para CORS (separadas por vírgula)
# Em desenvolvimento, pode usar * (inseguro em produção!)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# NOVOS RECURSOS: AUTENTICAÇÃO, DATABASE E CACHE
# ============================================================================

# --------- Autenticação JWT (para API v2) ---------
# Chave secreta para assinar tokens JWT (mude em produção!)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=sua-chave-secreta-super-segura-aqui

# --------- Banco de Dados (para histórico de resumos) ---------
# URL de conexão com banco de dados
# SQLite (simples, local): sqlite:///./pdf_summarizer.db
# PostgreSQL (produção): postgresql://user:password@localhost/database_name
# MySQL: mysql+pymysql://user:password@localhost/database_name
# DATABASE_URL=sqlite:///./pdf_summarizer.db

# --------- Redis Cache (para evitar reprocessamento) ---------
# Host do servidor Redis
# Padrão: localhost
# Se não configurado, o cache será desabilitado
# REDIS_HOST=localhost

# Porta do Redis
# Padrão: 6379
# REDIS_PORT=6379

# Banco de dados Redis (0-16)
# Padrão: 0
# REDIS_DB=0

# ============================================================================
# EXEMPLO DE .env PREENCHIDO
# ============================================================================
# ANTHROPIC_API_KEY=sk-ant-v0-ab1c2d3e4f5g6h7i8j9k0l1m2n3o4p5q
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
# MAX_FILE_SIZE_MB=10
# TIMEOUT_SECONDS=300
# LOG_LEVEL=INFO

